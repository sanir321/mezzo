    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource/commissioner": "^5.3.0",
    "crypto-js": "^4.2.0",
    "shaka-player": "^5.2.10"
