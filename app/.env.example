# -----------------------------------------------------------------------------
# Mezzo Environment Variables Template
# Copy this file to `.env` and fill in the values for your environment.
# -----------------------------------------------------------------------------

# Better Auth Secret (Generate a random 32+ character string, e.g. with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your_32_character_better_auth_secret_here

# Base URL of your application (e.g. http://localhost:5173 or https://your-domain.com)
BETTER_AUTH_URL=http://localhost:5173

# Optional: Google OAuth (for "Continue with Google")
# Redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth (for "Continue with GitHub")
# Redirect URI: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
