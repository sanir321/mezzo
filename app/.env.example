# -----------------------------------------------------------------------------
# Mezzo Environment Variables Template
# Copy this file to `.env` and fill in the values for your environment.
# -----------------------------------------------------------------------------

# Better Auth Secret (Generate a random 32+ character string, e.g. with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your_32_character_better_auth_secret_here

# Base URL of your application (e.g. http://localhost:5173 or https://your-domain.com)
BETTER_AUTH_URL=http://localhost:5173

# Optional: Google OAuth (for "Continue with Google")
# Redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth (for "Continue with GitHub")
# Redirect URI: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Tidal API (client_credentials grant). Leave empty to disable Tidal search/streaming.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Base URL of the dedicated HIFI streaming worker (stream resolution fallback).
# Defaults to http://localhost:8787 in dev and https://mezzo-hifi-api.zenosayz05.workers.dev in prod.
HIFI_API_BASE_URL=

# ---- SvelteKit dev note: the app reads VITE_-prefixed vars from `.env` in dev, and
#      the non-prefixed names from Cloudflare Worker/Pages bindings (globalThis.env) in prod.
#      Set VITE_TIDAL_CLIENT_ID / VITE_TIDAL_CLIENT_SECRET / VITE_HIFI_API_BASE_URL in `.env` for local dev.
VITE_TIDAL_CLIENT_ID=
VITE_TIDAL_CLIENT_SECRET=
VITE_HIFI_API_BASE_URL=http://localhost:8787
